# ── Environment Variables for Gold 4HR Reversal Strategy ──
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control!

# ── MetaApi Cloud Gateway (for Linux server deployment) ──
# Get your token from https://app.metaapi.cloud/
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# ── Telegram Notifications ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading Mode ──
# PAPER = simulated orders (default) | LIVE = real MT5 broker orders
TRADING_MODE=PAPER
